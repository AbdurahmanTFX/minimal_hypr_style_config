*.o

# Личное: список заметок и настройки звука, которые пишет dashboard
/dashboard_notes.dat
/notif_sound.dat

# Звук скачан со стороннего сайта, лицензия неизвестна. Без него играет системный
/sounds/

# Старые архивы версий
MyScripts/backup/

# Служебные файлы инструментов
.claude/
MyScripts/.claude/
